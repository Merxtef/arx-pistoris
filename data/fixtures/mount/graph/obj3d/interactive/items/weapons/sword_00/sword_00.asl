ON INIT {
 SETNAME [description_sword_00]
 SET_MATERIAL WEAPON
 SET_WEAPON_MATERIAL SWORD
 SETOBJECTTYPE WEAPON
 SETOBJECTTYPE 2H
 SETEQUIP DAMAGES 10
 SETEQUIP AIM_TIME 3000
 ACCEPT
}

ON EQUIPIN {
 PLAY "equip_sword"
 ACCEPT
}

ON INVENTORYUSE {
 EQUIP PLAYER
 ACCEPT
}

ON BREAK {
 PLAY "broken_weapon"
 DESTROY SELF
 ACCEPT
}
