ON INIT {
 SETNAME [description_custom_dagger]
 SET_MATERIAL WEAPON
 SET_WEAPON_MATERIAL DAGGER
 SETOBJECTTYPE WEAPON
 SETOBJECTTYPE DAGGER
 SETEQUIP DAMAGES 2
 SETEQUIP AIM_TIME 500
 ACCEPT
}

ON EQUIPIN {
 PLAY "equip_sword"
 ACCEPT
}

ON INVENTORYUSE {
 EQUIP PLAYER
 ACCEPT
}

ON BREAK {
 PLAY "broken_weapon"
 DESTROY SELF
 ACCEPT
}
