ON INIT {
 SETNAME [description_human_male_fireball_mage]
 SET @route 507
 ACCEPT
}

ON INITEND {
 LOADANIM CAST_START "human_male_start_unarmed_magic"
 LOADANIM CAST_CYCLE "human_male_channel_unarmed_magic"
 LOADANIM CAST       "human_male_cast_unarmed_magic"
 LOADANIM CAST_END   "human_male_end_unarmed_magic"
 
 TWEAK LEGS "medium_armor"
 TWEAK TORSO "medium_armor"

 TWEAK HEAD "head_4"
 GOSUB GO_TO_DESTINATION
 ACCEPT
}

ON REACHEDTARGET {
 IF (^TARGET == MARKER_0507) {
  SET @route 508
  GOSUB BEGIN_CAST
  REFUSE
 }
 IF (^TARGET == MARKER_0508) {
  SET @route 509
  GOSUB BEGIN_CAST
  REFUSE
 }
 IF (^TARGET == MARKER_0509) {
  SET @route 507
  GOSUB BEGIN_CAST
  REFUSE
 }
 ACCEPT
}

ON PATHFINDER_FAILURE {
 TIMERturn OFF
 TIMERcast_guard OFF
 TIMERcast_end OFF
 TIMERresume OFF
 BEHAVIOR FRIENDLY
 TIMERretry 1 2 GOSUB GO_TO_DESTINATION ACCEPT
 REFUSE
}

ON SPELLCAST {
 IF (^SENDER != ^ME) ACCEPT
 IF (^$PARAM1 != FIREBALL) ACCEPT

 TIMERcast_guard OFF
 TIMERcast_end 1 0.45 PLAYANIM -2 CAST_END
 TIMERresume 1 2.2 GOSUB GO_TO_DESTINATION ACCEPT
 REFUSE
}

>>BEGIN_CAST
 TIMERretry OFF
 BEHAVIOR FRIENDLY
 SETTARGET MARKER_0510
 TIMERturn 1 1 GOTO CAST_FIREBALL
RETURN

>>CAST_FIREBALL
 TIMERcast_guard 1 6 GOSUB GO_TO_DESTINATION ACCEPT
 SPELLCAST -f 3 FIREBALL MARKER_0510
ACCEPT

>>GO_TO_DESTINATION
 TIMERturn OFF
 TIMERcast_guard OFF
 TIMERcast_end OFF
 TIMERresume OFF
 TIMERretry OFF
 PLAYANIM -2 NONE
 BEHAVIOR MOVE_TO
 SETMOVEMODE RUN
 IF (@route == 507) {
  SETTARGET MARKER_0507
  RETURN
 }
 IF (@route == 508) {
  SETTARGET MARKER_0508
  RETURN
 }
 IF (@route == 509) {
  SETTARGET MARKER_0509
  RETURN
 }
RETURN
