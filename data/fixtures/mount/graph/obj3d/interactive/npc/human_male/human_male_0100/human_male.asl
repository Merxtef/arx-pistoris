ON INIT {
 SETNAME [description_human_male_dummy]
 ACCEPT
}

ON INITEND {
 TWEAK LEGS "heavy_armor"
 TWEAK HEAD "head_3"

 BEHAVIOR FRIENDLY
 SETTARGET PLAYER
 PLAYANIM -l WAIT

 TIMERambient -i 0 12 PLAYANIM -e ACTION1 PLAYANIM -l WAIT

 ACCEPT
}

ON CHAT {
 PLAYANIM -e ACTION2 PLAYANIM -l WAIT
 ACCEPT
}
