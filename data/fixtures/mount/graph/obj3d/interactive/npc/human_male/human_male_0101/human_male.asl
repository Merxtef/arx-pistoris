ON INIT {
 SETNAME [description_human_male_patrol_guard]
 SET @route 500
 ACCEPT
}

ON INITEND {
 TWEAK HEAD "head_2"
 TWEAK TORSO "medium_armor"
 GOSUB GO_TO_DESTINATION
 ACCEPT
}

ON REACHEDTARGET {
 IF (^TARGET == MARKER_0500) {
  SET @route 501
  GOSUB WAIT_FOR_ROUTE
  REFUSE
 }
 IF (^TARGET == MARKER_0501) {
  SET @route 502
  GOSUB WAIT_FOR_ROUTE
  REFUSE
 }
 IF (^TARGET == MARKER_0502) {
  SET @route 503
  GOSUB WAIT_FOR_ROUTE
  REFUSE
 }
 IF (^TARGET == MARKER_0503) {
  SET @route 504
  GOSUB WAIT_FOR_ROUTE
  REFUSE
 }
 IF (^TARGET == MARKER_0504) {
  SET @route 500
  GOSUB WAIT_FOR_ROUTE
  REFUSE
 }
 ACCEPT
}

ON PATHFINDER_FAILURE {
 TIMERroute OFF
 BEHAVIOR FRIENDLY
 TIMERretry 1 2 GOSUB GO_TO_DESTINATION ACCEPT
 REFUSE
}

>>WAIT_FOR_ROUTE
 TIMERretry OFF
 BEHAVIOR FRIENDLY
 TIMERroute 1 2 GOSUB GO_TO_DESTINATION ACCEPT
RETURN

>>GO_TO_DESTINATION
 TIMERroute OFF
 TIMERretry OFF
 BEHAVIOR MOVE_TO
 SETMOVEMODE RUN
 IF (@route == 500) {
  SETTARGET MARKER_0500
  RETURN
 }
 IF (@route == 501) {
  SETTARGET MARKER_0501
  RETURN
 }
 IF (@route == 502) {
  SETTARGET MARKER_0502
  RETURN
 }
 IF (@route == 503) {
  SETTARGET MARKER_0503
  RETURN
 }
 IF (@route == 504) {
  SETTARGET MARKER_0504
  RETURN
 }
RETURN
