ResourceSelector: TypeAlias = (
    ModelSelector | AnimationSelector | LevelSelector | CinematicSelector | AmbianceSelector
)

class SearchLocation:
    @property
    def base_path(self) -> str: ...
    @property
    def max_discovery_depth(self) -> int: ...

def selector_from_string(selector: str) -> ResourceSelector:
    """Parse a selector string and return its concrete selector type."""
    ...
def selector_from_path(path: str | PathLike[str]) -> ResourceSelector:
    """Parse a canonical primary resource path and return its concrete selector type."""
