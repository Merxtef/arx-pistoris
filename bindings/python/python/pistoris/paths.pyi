from enum import Enum, StrEnum
from os import PathLike
from typing import TypeAlias, overload

class ModelType(StrEnum):
    NPC: ModelType
    FIX_INTER: ModelType
    SYSTEM: ModelType
    ARMOR: ModelType
    JEWELRY: ModelType
    MAGIC: ModelType
    MOVABLE: ModelType
    PROVISIONS: ModelType
    QUEST_ITEM: ModelType
    SPECIAL: ModelType
    WEAPONS: ModelType
    UI_RUNES: ModelType
    UI_MENUS: ModelType
    EDITOR: ModelType

class AnimationType(StrEnum):
    NPC: AnimationType
    FIX_INTER: AnimationType

class ResourceKind(Enum):
    LEVEL: ResourceKind
    MODEL: ResourceKind
    ANIMATION: ResourceKind
    CINEMATIC: ResourceKind
    AMBIANCE: ResourceKind

class EntityClassKind(Enum):
    UNKNOWN: EntityClassKind
    ITEM: EntityClassKind
    NPC: EntityClassKind
    FIX: EntityClassKind
    CAMERA: EntityClassKind
    MARKER: EntityClassKind

class ModelSelector:
    """A validated, immutable Model resource identity."""
    def __init__(self, type: ModelType, name: str, tweak: str = "") -> None: ...
    @property
    def type(self) -> ModelType: ...
    @property
    def name(self) -> str: ...
    @property
    def tweak(self) -> str: ...
    @property
    def kind(self) -> ResourceKind: ...
    def __str__(self) -> str: ...
    def to_path(self) -> str: ...
    @staticmethod
    def parse(selector: str) -> ModelSelector: ...
    @staticmethod
    def from_path(path: str | PathLike[str]) -> ModelSelector: ...

class AnimationSelector:
    """A validated, immutable Animation resource identity."""
    def __init__(self, type: AnimationType, name: str) -> None: ...
    @property
    def type(self) -> AnimationType: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> ResourceKind: ...
    def __str__(self) -> str: ...
    def to_path(self) -> str: ...
    @staticmethod
    def parse(selector: str) -> AnimationSelector: ...
    @staticmethod
    def from_path(path: str | PathLike[str]) -> AnimationSelector: ...

class LevelSelector:
    """A Level identity whose canonical path is its primary DLF."""
    def __init__(self, level: int) -> None: ...
    @property
    def level(self) -> int: ...
    @property
    def kind(self) -> ResourceKind: ...
    def __str__(self) -> str: ...
    def to_path(self) -> str: ...
    def associated_llf(self) -> str: ...
    def associated_fts(self) -> str: ...
    @staticmethod
    def parse(selector: str) -> LevelSelector: ...
    @staticmethod
    def from_path(path: str | PathLike[str]) -> LevelSelector: ...

class CinematicSelector:
    """A validated, immutable Cinematic resource identity."""
    def __init__(self, name: str) -> None: ...
